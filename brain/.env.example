# Copy to brain/.env and fill in. Never commit a real value. Real environment variables win
# over this file. Every name the brain reads is listed here; README.md says what each does.
# Contact details (CONTACT_FACETIME_TO, CONTACT_EMAIL_TO) are not read by this build.

# --- Names shared with the repo's root .env.example
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
CONTACT_LABEL=
ARGOS_DRY_RUN=
CHECK_TIMEOUT_S=
SERIAL_PORT=
ARGOS_LIVE_VIEW=
LIVE_VIEW_FPS=

# --- Brain only: the robot and local files
ARGOS_ROBOT=
ARGOS_ROBOT_ANTENNA_PAT=
ARGOS_ACK_POLL_S=
ARGOS_LOG_DIR=
ARGOS_CACHE_DIR=

# --- Brain only: camera and detection thresholds
ARGOS_CAMERA=
ARGOS_CAMERA_WIDTH=
ARGOS_CAMERA_HEIGHT=
ARGOS_CAMERA_HFOV_DEG=
ARGOS_DETECT_FPS=
ARGOS_POSE_MODEL=
ARGOS_PERSON_MIN_SCORE=
ARGOS_FALL_ANGLE_DEG=
ARGOS_FALL_HOLD_S=
ARGOS_STILLNESS_S=
ARGOS_STILL_MOVE=
ARGOS_TRIGGER_COOLDOWN_S=

# --- Brain only: listening and voice
ARGOS_LISTEN=
ARGOS_VOSK_MODEL=
ARGOS_AUDIO_IN=
ARGOS_AUDIO_OUT=
ARGOS_HELP_MIN_CONF=
ELEVENLABS_MODEL=

# --- Brain only: Gemini and the time limits after an escalation
GEMINI_MODEL=
ARGOS_GEMINI_TIMEOUT_S=
ARGOS_SUMMARY_TIMEOUT_S=
ARGOS_SNAPSHOT_TIMEOUT_S=
