# Copy to .env (root, web/ or brain/ as each part needs) and fill in. Never commit a real value.

# --- Dashboard (web/). Vite only exposes names that start with VITE_ ---
VITE_SUPABASE_URL=
# The publishable key (starts sb_publishable_). Safe in a browser. Never the secret key.
VITE_SUPABASE_PUBLISHABLE_KEY=
# "replay" plays contract/fixtures/demo_scenario.jsonl. "live" reads Supabase.
VITE_DATA_MODE=replay

# --- Laptop brain (brain/) ---
SUPABASE_URL=
# Service role key. Laptop only. Never in web/, never in the browser.
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
CHERT_API_KEY=
EMAIL_API_KEY=

# --- Call agent (call/). Runs on a laptop. Also reads SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY,
# GEMINI_API_KEY, ELEVENLABS_API_KEY, ELEVENLABS_VOICE_ID and the contact settings below ---
CHERT_PROJECT_ID=
# Leave empty to let the call agent find the line.
CHERT_LINE_ID=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Who gets called and emailed on escalation. Real values stay here, never in a record.
CONTACT_LABEL=Daughter
CONTACT_FACETIME_TO=
CONTACT_EMAIL_TO=

# 1 = log the call and the email but place neither. Default. Set 0 only for a real run.
ARGOS_DRY_RUN=1
CHECK_TIMEOUT_S=10
# Leave empty to run with no body attached.
SERIAL_PORT=

# Live view. Off unless set to 1. Frames are never stored.
ARGOS_LIVE_VIEW=0
LIVE_VIEW_FPS=4
