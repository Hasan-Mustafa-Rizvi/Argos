# Copy to call/.env.local and fill in. Never commit a real value. Real environment variables
# win over the file. Every name the call agent reads is listed here; README.md says what each
# does and where its value comes from.

# --- Names shared with the repo's root .env.example
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
CHERT_API_KEY=
CHERT_PROJECT_ID=
CHERT_LINE_ID=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
GEMINI_API_KEY=
CONTACT_LABEL=
CONTACT_FACETIME_TO=
ARGOS_DRY_RUN=1

# --- Call agent only. All optional.
ELEVENLABS_MODEL=
GEMINI_MODEL=
CHERT_API_BASE=
ARGOS_CALL_STATE_DIR=
ARGOS_CALL_POLL_S=
ARGOS_VOSK_MODEL=
